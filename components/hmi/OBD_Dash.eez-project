                  "localStyles": {
                    "objID": "2d09e623-72a7-4d65-bbed-e4516f4346fd",
                    "definition": {
                      "MAIN": {
                        "DEFAULT": {
                          "text_color": "#8a96a3",
                          "text_font": "MONTSERRAT_16"
                        }
                      }
                    }
                  },
                  "group": "",
                  "groupIndex": 0,
                  "text": "Manufacturer diagnostics over UDS (VW group, Mercedes first):\n- ECU scan: which control units answer\n- identification (part number, software, VIN, serial)\n- trouble codes per ECU, clear with confirmation\n- read data by identifier\n- texts and decoding from a database on the SD card, built with a PC tool\n- read only: no coding, no security access, no routines\n- over the board CAN or a BLE ELM327 adapter",
                  "textType": "literal",
                  "longMode": "WRAP",
                  "recolor": false
                }
              ],
