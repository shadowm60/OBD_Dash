# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.2.0 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_DATA_CACHE_LINE_SIZE=64
# Larger caches: LVGL renders into PSRAM frame buffers (Espressif RGB LCD recommendation)
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Wi-Fi + Bluetooth LE next to the display (settings from Esp32_monitor).
# Internal RAM is the tight resource: RGB bounce buffers, Wi-Fi and the BT
# controller all need it.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Statics tagged EXT_RAM_BSS_ATTR live in PSRAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Plain malloc() prefers PSRAM for every size (default: < 16 KB internal
# first). LVGL objects and EEZ Flow values are thousands of small mallocs and
# would use up internal RAM next to Wi-Fi + BT. Code that needs internal RAM
# (DMA, ISR, FreeRTOS objects, Wi-Fi/BT internals) asks for it explicitly.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
# Bluetooth LE only (the S3 has no classic BT), NimBLE host, central role
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# SD card: long file names (YYYYMMDD_HHMMSS logs once the clock is known)
CONFIG_FATFS_LFN_HEAP=y

# BSW Display Configuration
CONFIG_BSW_LVGL_PORT_TASK_CORE=1
CONFIG_BSW_LVGL_PORT_AVOID_TEAR_ENABLE=y
CONFIG_BSW_LVGL_PORT_AVOID_TEAR_MODE_3=y

# BSW Hardware Peripheral Pins (Waveshare ESP32-S3-Touch-LCD-5)
CONFIG_CAN_TX=15
CONFIG_CAN_RX=16
CONFIG_I2C_MASTER_SCL=9
CONFIG_I2C_MASTER_SDA=8
CONFIG_SDCARD_PIN_MOSI=11
CONFIG_SDCARD_PIN_MISO=13
CONFIG_SDCARD_PIN_CLK=12
CONFIG_SDCARD_PIN_CS=-1

CONFIG_LV_COLOR_SCREEN_TRANSP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
# CONFIG_LV_USE_PERF_MONITOR is not set
# < one panel frame (~25.6 ms at 16 MHz pclk) so every vsync can be used
CONFIG_LV_DISP_DEF_REFR_PERIOD=15
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_USE_IMGFONT=y
# CONFIG_LV_USE_DEMO_WIDGETS is not set
# CONFIG_LV_USE_DEMO_BENCHMARK is not set
# CONFIG_LV_USE_DEMO_STRESS is not set
# CONFIG_LV_USE_DEMO_MUSIC is not set
CONFIG_TWAI_SUPPRESS_DEPRECATE_WARN=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
